+        MdbxWriteCommand::CreateEntry { entry_id: entry.clone(), project_id: project.clone(),
+            entry_type: "login".into(), title: "before".into(), payload_json: r#"{"password_plain":"synthetic","future":9007199254740993}"#.into() },
