<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:label="Monica Icon Fixture">
        <activity
            android:name="takagi.ru.monica.ui.icons.IconPackFixtureActivity"
            android:exported="true"
            android:icon="@drawable/icon_fixture_star">
            <intent-filter>
                <action android:name="org.adw.launcher.THEMES" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:name="takagi.ru.monica.autofill_ng.fixture.AutofillFormFixtureActivity"
            android:exported="true"
            android:process=":autofill_fixture"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />
        <service
            android:name="takagi.ru.monica.autofill_ng.fixture.AutofillFixtureInputMethodService"
            android:exported="true"
            android:permission="android.permission.BIND_INPUT_METHOD"
            android:process=":autofill_fixture">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data android:name="android.view.im" android:resource="@xml/autofill_fixture_input_method" />
        </service>
        <provider
            android:name="takagi.ru.monica.credentialexchange.TransferReceiverTestProvider"
            android:authorities="takagi.ru.monica.test.exchange-receiver"
            android:process=":credential_exchange_receiver"
            android:exported="true"
            android:forceUriPermissions="true"
            android:grantUriPermissions="true" />
        <provider
            android:name="takagi.ru.monica.repository.StaleSizeContentProvider"
            android:authorities="takagi.ru.monica.test.stale-size"
            android:exported="true"
            android:grantUriPermissions="true" />
        <provider
            android:name="takagi.ru.monica.ui.cardwallet.CardFaceTestImageProvider"
            android:authorities="takagi.ru.monica.test.cardface.images"
            android:exported="true" />
    </application>
</manifest>
