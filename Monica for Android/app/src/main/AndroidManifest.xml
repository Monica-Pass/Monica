<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Biometric permission for fingerprint/face unlock -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />
    <uses-permission android:name="android.permission.HIDE_OVERLAY_WINDOWS" />
    
    <!-- Camera permission for QR code scanning -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    
    <!-- Network permissions for WebDAV backup -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    
    <!-- Storage permissions for saving images -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    
    <!-- Autofill permission -->
    <uses-permission android:name="android.permission.BIND_AUTOFILL_SERVICE"
        tools:ignore="ProtectedPermissions" />
    
    <!-- Phase 9: Haptic feedback permission -->
    <uses-permission android:name="android.permission.VIBRATE" />
    
    <!-- Foreground Service permissions for Notification Validator -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"
        android:minSdkVersion="34" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"
        android:minSdkVersion="33" />
    
    <!-- 添加电话状态权限 -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    
    <!-- 如果需要精确位置 -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Android 11+ 包可见性声明 - 用于应用列表功能 -->
    <queries>
        <package android:name="moe.shizuku.privileged.api" />
        <intent>
            <action android:name="androidx.identitycredentials.action.IMPORT_CREDENTIALS" />
            <data android:scheme="content" />
        </intent>
        <intent>
            <action android:name="androidx.identitycredentials.action.IMPORT_CREDENTIALS" />
            <data android:scheme="content" android:mimeType="*/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".MonicaApplication"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="false"
        android:usesCleartextTraffic="true"
        android:icon="@mipmap/ic_launcher_modern"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_modern_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Monica"
        tools:targetApi="31">
        <activity
            android:name=".credentialexchange.CredentialExportActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.Monica"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="androidx.identitycredentials.action.IMPORT_CREDENTIALS" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
            </intent-filter>
            <!-- The SDK FileProvider infers application/octet-stream for its extensionless file.
                 Keep the untyped filter above for providers following the documentation example. -->
            <intent-filter>
                <action android:name="androidx.identitycredentials.action.IMPORT_CREDENTIALS" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/json" />
            </intent-filter>
        </activity>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Monica"
            android:windowSoftInputMode="adjustResize"
            tools:targetApi="33">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="otpauth" android:host="totp" />
                <data android:scheme="otpauth" android:host="hotp" />
                <data android:scheme="otpauth" android:host="yaotp" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.microsoft.identity.client.BrowserTabActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="msauth"
                    android:host="takagi.ru.monica"
                    android:path="/FwPDMDAjg96+0gxjMKKmnQS/dQA=" />
            </intent-filter>
        </activity>

        <activity-alias
            android:name=".ModernLauncherAlias"
            android:enabled="false"
            android:exported="true"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity" />

        <activity-alias
            android:name=".LockLauncherAlias"
            android:enabled="true"
            android:exported="true"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity" />

        <activity-alias
            android:name=".ModernHomeLauncherAlias"
            android:enabled="true"
            android:exported="true"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity" />

        <activity-alias
            android:name=".ClassicHomeLauncherAlias"
            android:enabled="true"
            android:exported="true"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity" />

        <activity-alias
            android:name=".ModernVisibleLauncherAlias"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_modern"
            android:roundIcon="@mipmap/ic_launcher_modern_round"
            android:label="@string/app_label"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".ClassicVisibleLauncherAlias"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_modern"
            android:roundIcon="@mipmap/ic_launcher_modern_round"
            android:label="@string/app_label"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".ModernVisibleLauncherAliasMonica"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_modern"
            android:roundIcon="@mipmap/ic_launcher_modern_round"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".ClassicVisibleLauncherAliasMonica"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_modern"
            android:roundIcon="@mipmap/ic_launcher_modern_round"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Easter-egg launcher entry shown while the Cheese Snow Leopard language is
             selected. Always disabled here; AppLauncherIconManager toggles exactly one
             visible alias on at runtime. -->
        <activity-alias
            android:name=".SnowLeopardVisibleLauncherAlias"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_snow_leopard"
            android:roundIcon="@mipmap/ic_launcher_snow_leopard_round"
            android:label="@string/app_label"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <service
            android:name=".transfer.DatabaseExportService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="dataSync" />

        <!-- Autofill Service (Bitwarden engine) -->
        <service
            android:name=".autofill_ng.MonicaAutofillServiceNg"
            android:label="@string/autofill_service_label"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE"
            android:exported="false">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
            <meta-data
                android:name="android.autofill"
                android:resource="@xml/autofill_service_config" />
        </service>
        
        <!-- Credential Provider Service (Passkey, Android 14+) -->
        <service
            android:name=".passkey.MonicaCredentialProviderService"
            android:label="@string/app_name"
            android:icon="@mipmap/ic_launcher_modern"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.BIND_CREDENTIAL_PROVIDER_SERVICE"
            tools:targetApi="upside_down_cake">
            <intent-filter>
                <action android:name="android.service.credentials.CredentialProviderService" />
            </intent-filter>
            <meta-data
                android:name="android.credentials.provider"
                android:resource="@xml/credential_provider_config" />
        </service>

        <receiver
            android:name=".passkey.CredentialProviderRefreshReceiver"
            android:exported="true"
            tools:targetApi="upside_down_cake">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.PACKAGE_REPLACED" />
                <data android:scheme="package" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".receiver.LauncherEntryRepairReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        
        <!-- Passkey Create Activity -->
        <activity
            android:name=".passkey.PasskeyCreateActivity"
            android:theme="@style/Theme.Monica.Passkey"
            android:exported="false"
            android:excludeFromRecents="true" />
        
        <!-- Passkey Auth Activity -->
        <activity
            android:name=".passkey.PasskeyAuthActivity"
            android:theme="@style/Theme.Monica.Passkey"
            android:exported="false"
            android:excludeFromRecents="true" />

        <!-- Passkey Settings Activity (for system settings entry) -->
        <activity
            android:name=".passkey.PasskeySettingsActivity"
            android:theme="@style/Theme.Monica"
            android:exported="true" />
        
        <receiver android:name=".autofill_ng.utils.SmartCopyReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="takagi.ru.monica.ACTION_SMART_COPY" />
            </intent-filter>
        </receiver>

        <!-- Quick Settings Tile for Manual Autofill -->
        <service
            android:name=".autofill_ng.service.AutofillTileService"
            android:label="@string/tile_autofill_label"
            android:icon="@drawable/ic_key"
            android:exported="true"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Autofill OTP Notification Service: real-time TOTP in notification bar -->
        <service
            android:name=".autofill_ng.service.AutofillOtpNotificationService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            tools:targetApi="34">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Displaying autofill TOTP codes in notification"
                tools:targetApi="34" />
        </service>

        <!-- Notification Validator Service -->
        <service
            android:name=".service.NotificationValidatorService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            tools:targetApi="34">
            <!-- Android 14+ specific attributes -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Displaying TOTP codes in notification"
                tools:targetApi="34" />
        </service>

        <!-- Accessibility Service -->
        <activity
            android:name=".autofill_ng.protection.AutofillProtectionActivity"
            android:exported="false"
            android:theme="@style/Theme.Monica" />
        <service
            android:name=".autofill_ng.protection.AutofillProtectionService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-enabled accessibility autofill availability monitoring with a persistent status notification and stop action" />
        </service>
        <receiver
            android:name=".autofill_ng.protection.AutofillProtectionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <!-- Keep automatic Sui initialization: Sui can also grant Shell access.
             Recovery checks the actual backend UID and permission before using it. -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <service
            android:name=".service.MonicaAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <service
            android:name=".ime.MonicaInputMethodService"
            android:label="@string/ime_monica_label"
            android:icon="@drawable/ic_key"
            android:permission="android.permission.BIND_INPUT_METHOD"
            android:process=":ime"
            android:exported="true">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/monica_input_method" />
        </service>

        <activity
            android:name=".ime.ImeBiometricAuthActivity"
            android:exported="false"
            android:theme="@style/Theme.ImeBiometricAuth"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=":ime_biometric"
            android:launchMode="singleTask"
            android:process=":ime" />

        <activity
            android:name=".ime.ImeUnlockActivity"
            android:exported="false"
            android:theme="@style/Theme.TransparentDialog"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=":ime_unlock"
            android:launchMode="singleTask"
            android:process=":ime" />
        
        <!-- Autofill Save Activity (旧版全屏) -->
        <activity
            android:name=".autofill_ng.AutofillSaveActivity"
            android:exported="false"
            android:theme="@style/Theme.Monica"
            android:excludeFromRecents="true"
            android:launchMode="singleTop" />
        
        <!-- Autofill Save Activity (Keyguard 风格全屏) -->
        <activity
            android:name=".autofill_ng.AutofillSaveTransparentActivity"
            android:exported="false"
            android:theme="@style/Theme.Monica"
            android:excludeFromRecents="true"
            android:taskAffinity=":autofill_save"
            android:launchMode="singleTask"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize" />
        
        <!-- Phase 8: Biometric Authentication Activity for Autofill -->
        <activity
            android:name=".autofill_ng.BiometricAuthActivity"
            android:exported="false"
            android:theme="@style/Theme.Transparent"
            android:excludeFromRecents="true" />
        
        <!-- Autofill Authentication Activity -->
        <activity
            android:name=".autofill_ng.AutofillAuthenticationActivity"
            android:exported="false"
            android:theme="@style/Theme.TransparentDialog"
            android:excludeFromRecents="true" />

        <activity
            android:name=".autofill_ng.AutofillUnlockActivity"
            android:exported="false"
            android:theme="@style/Theme.Monica.AutofillCallback"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity="" />

        <activity
            android:name=".autofill_ng.AutofillCipherCallbackActivity"
            android:exported="false"
            android:theme="@style/Theme.Monica.AutofillCallback"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity="" />
        
        <!-- Autofill Picker Activity (UI Improvement) -->
        <activity
            android:name=".autofill_ng.AutofillPickerActivity"
            android:exported="false"
            android:theme="@style/Theme.Monica.BottomSheet"
            android:excludeFromRecents="true" />
        
        <!-- Autofill Picker Activity V2 (Keyguard Style Full Screen) -->
        <activity
            android:name=".autofill_ng.AutofillPickerActivityV2"
            android:exported="false"
            android:theme="@style/Theme.Monica"
            android:excludeFromRecents="true" />

        <activity
            android:name=".autofill_ng.AutofillInlinePlaceholderActivity"
            android:exported="false"
            android:theme="@style/Theme.Transparent"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:launchMode="singleTop" />
        

        <!-- 🔐 Password Suggestion Activity (Strong Password Generator) -->
        <activity
            android:name=".autofill_ng.PasswordSuggestionActivity"
            android:exported="false"
            android:theme="@style/Theme.TransparentDialog"
            android:excludeFromRecents="true"
            android:taskAffinity="" />
        
        <!-- FileProvider for camera photos -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>

