    <string name="lan_title">附近設備同步</string>
    <string name="lan_description">在同一 Wi-Fi 下同步手機和電腦的密碼庫。發現設備後輸入配對碼，也可以掃描對方的QR 碼連接。</string>
    <string name="lan_select_vault">選擇密碼庫</string>
