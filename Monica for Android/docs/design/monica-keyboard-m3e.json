{
  "title": "Monica · 键盘与 PIN",
  "brief": "参考 Gboard 的等宽字母键、居中的第二排、对称 Shift / 删除以及胶囊 Enter，保留密码库入口，提供可关闭的数字键随机与预览隐藏。",
  "frame": "phone",
  "platform": "android",
  "paletteKey": "teal",
  "theme": {
    "dark": true,
    "bothModes": true,
    "shape": "rounded",
    "font": "roboto",
    "motion": "expressive"
  },
  "frames": [
    {
      "id": "letters",
      "name": "字母键盘",
      "x": 0,
      "y": 0,
      "note": "所有字母键等宽等高，第二排居中缩进；Shift 与删除对称。按键高 48dp、横向间距 4dp、行距 8dp；左右 8dp；Enter 与模式键为胶囊。大屏居中且最大宽度 600dp。"
    },
    {
      "id": "pin",
      "name": "随机数字键盘",
      "x": 492,
      "y": 0,
      "note": "随机示例。每次打开数字键盘仅洗牌一次，输入过程中稳定。可独立隐藏数字预览。数字、删除和 Enter 等高，不再把 Enter 拉成三排。"
    },
    {
      "id": "settings",
      "name": "自动填充设置",
      "x": 984,
      "y": 0,
      "note": "自动填充设置中的 Monica 键盘区。两个选项默认关闭，保存后立即应用；隐藏预览控制 Monica 数字按键的弹泡和高亮，不影响宿主输入框。"
    },
    {
      "id": "search",
      "name": "密码搜索",
      "x": 1476,
      "y": 0,
      "note": "搜索匹配条目标题、用户名、网站及应用信息；来源只由独立筛选器选择，Bitwarden 不再命中整个来源。"
    }
  ],
