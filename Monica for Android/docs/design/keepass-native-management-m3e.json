{
  "title": "Monica · KeePass 原生条目管理",
  "brief": "原生详情查看验证码、标签与有效期；编辑保持登录、自定义字段、附件和历史完整。HOTP 下一码先写入数据库，成功后更新显示。",
  "frame": "phone",
  "platform": "android",
  "paletteKey": "purple",
  "theme": {
    "dark": false,
    "bothModes": true,
    "contrast": "standard",
    "shape": "rounded",
    "font": "system",
    "motion": "expressive"
  },
  "frames": [
    {
      "id": "detail",
      "name": "条目详情",
      "x": 0,
      "y": 0,
      "note": "保留现有详情页。验证码卡片位于登录信息与备注之间；复用验证器磁贴，复制可达。标签和有效期始终可见。"
    },
    {
      "id": "editor",
      "name": "编辑条目",
      "x": 492,
      "y": 0,
      "note": "沿用原生字段和 OTP 编辑。增加标签与有效期分组；与字段、图标一起原子保存，大字体可滚动。"
    },
    {
      "id": "hotp",
      "name": "HOTP 下一码",
      "x": 984,
      "y": 0,
      "note": "只读时禁用增加计数器。保存失败保留原计数器和验证码，展示可重试错误。未识别格式仍展示原始字段。"
    }
  ],
