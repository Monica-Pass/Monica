    "module": "[\n  {\n    \"id\": \"oh_my_keymint\",\n    \"name\": \"Oh My Keymint\",\n    \"update\": \"false\",\n    \"remove\": \"false\",\n    \"web\": \"true\",\n    \"action\": \"false\",\n    \"description\": \"Custom keystore implementation for Android Keystore Spoofer\",\n    \"version\": \"1.3.5 (1-ba6f300-release)\",\n    \"mount\": \"false\",\n    \"enabled\": \"true\",\n    \"versionCode\": \"1\",\n    \"author\": \"James Clef,ITxiao6666\",\n    \"updateJson\": \"https://raw.githubusercontent.com/ITxiao6666/OhMyKeymint/changelog/update.json\"\n  }\n]",
