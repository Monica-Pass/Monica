    "payload": "512 libcd0afa04c0ca996468a92c4cc3f25929.so",
    "scope": "# With `[filter].enabled = true`, caller UID and resolved packages select OMK.\n# Targets: package (all users), package@user_id, or uid:full_android_uid.\n# Matching one shared-UID package selects the entire UID.\n# Filter deny settings still apply to every package resolved for the UID.\n\nversion = 1\n\n\nscoop = [\n  \"takagi.ru.monica@10\",\n  \"takagi.ru.monica.fdroid@10\",\n  \"takagi.ru.monica@11\",\n  \"takagi.ru.monica.fdroid@11\"\n]\n\n[main]\nenabled = true\nlog_level = \"debug\"\n# Optional delay before challenged OMK generation, 0..250 ms; 0 disables it.\nattestation_generation_delay_ms = 0\n# Optional delay before two-way OMK createOperation calls, 0..250 ms; 0 disables it.\noperation_start_delay_ms = 0\n\n[filter]\nenabled = true\ndeny_packages = []\nblock_android_package = true\nallow_unknown_package = false\n\n[intercept]\nget_security_level = true\nget_key_entry = true\nupdate_subcomponent = true\nlist_entries = true\ndelete_key = true\ngrant = true\nungrant = true\nget_number_of_entries = true\nlist_entries_batched = true\nget_supplementary_attestation_info = true",
